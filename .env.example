# ---------------------------------------------------------------------------
# LinkCall — Vercel environment variables
#
# Copy these into Vercel → Project → Settings → Environment Variables.
# This file is a TEMPLATE: it holds no real secrets. Never commit real values.
#
# After changing any of these you MUST redeploy (Vercel → Deployments →
# ...→ Redeploy) — env vars are baked in at deploy time.
# ---------------------------------------------------------------------------

# === Telegram bot ==========================================================
# @BotFather → /mybots → your bot → API Token
BOT_TOKEN=

# Public HTTPS URL of this deployment, no trailing slash.
# Used to build the Web App button URL in /start and to register the webhook.
PUBLIC_URL=https://your-app.vercel.app

# Random string you invent; Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so /api/webhook can reject fakes.
# REQUIRED: without it /api/webhook answers 503 and Stars payments are refused,
# because a forged successful_payment would otherwise grant free unlocks.
WEBHOOK_SECRET=

# === Admin panel ===========================================================
# These are the ONLY source of admin credentials. Nothing is hardcoded in the
# frontend, so the panel is closed until both are set.
#
# ADMIN_ID: pick something that is NOT "admin" / "root" / your name.
#           e.g. "lc_ops_7f3a"
ADMIN_ID=

# ADMIN_PASSWORD: 12+ characters, random. Generate one with:
#   openssl rand -base64 24
# Changing it logs out every existing admin session.
ADMIN_PASSWORD=

# Optional but recommended. Signs the session token independently of the
# password, so rotating this kills all sessions without changing the password.
# If unset it is derived from ADMIN_PASSWORD.
#   openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# === Firebase ==============================================================
# Whole service-account JSON on ONE line (minified), in quotes.
#
# Get it: Firebase Console → Project Settings → Service Accounts →
#         Generate new private key  → a .json file downloads.
# Then minify it so the newlines cannot break the env var:
#   node -e "console.log(JSON.stringify(require('./serviceAccount.json')))"
# Paste that single line as the value.
#
# NEVER commit this value and never prefix it with NEXT_PUBLIC_ / VITE_.
FIREBASE_SERVICE_ACCOUNT=

# Realtime Database URL from Firebase Console → Realtime Database.
# Optional: leave blank if you only use Firestore.
FIREBASE_DATABASE_URL=

# ===========================================================================
# NOTHING ELSE IS NEEDED. There are no other environment variables.
#
# The three user-facing settings are NOT env vars — they live in Firestore and
# are changed from the admin panel at /admin → Settings, with no redeploy:
#
#   document  config/app
#     paymentRequired : true|false    Free or paid gender filter
#     priceStars      : 1..10000      price in Telegram Stars (XTR)
#     channelUrl      : string        "Join our Channel" link ("" hides it)
#
#   Defaults when the document is missing (i.e. a brand-new project):
#     { paymentRequired: true, priceStars: 50, channelUrl: "https://t.me/YOUR_CHANNEL" }
#
#   Read them from outside with:  curl https://your-app.vercel.app/api/config
#
# The whole backend is ONE file, api/index.js. Do not add more files to api/ —
# Vercel's free plan limits the number of functions, and extra files shadow the
# catch-all rewrite. See PART 14 of Readme.txt.
# ===========================================================================
